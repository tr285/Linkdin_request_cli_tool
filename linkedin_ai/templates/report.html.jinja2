<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>liai — LinkedIn Networking Report</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0f1e;
    --surface: #111827;
    --surface2: #1f2937;
    --accent: #6366f1;
    --accent-light: #818cf8;
    --green: #10b981;
    --yellow: #f59e0b;
    --red: #ef4444;
    --text: #f1f5f9;
    --muted: #94a3b8;
    --border: #1e293b;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', system-ui, sans-serif;
    padding: 2.5rem;
    min-height: 100vh;
  }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .logo { display: flex; align-items: center; gap: 0.75rem; }
  .logo h1 { font-size: 1.6rem; font-weight: 700; color: var(--accent-light); letter-spacing: -0.02em; }
  .logo span { font-size: 0.8rem; color: var(--muted); }
  .meta { font-size: 0.8rem; color: var(--muted); text-align: right; }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem;
    text-align: center;
  }
  .stat-card .number { font-size: 2rem; font-weight: 700; color: var(--accent-light); }
  .stat-card .label { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 0.25rem; }

  .table-container { overflow-x: auto; border-radius: 16px; border: 1px solid var(--border); }
  table { width: 100%; border-collapse: collapse; background: var(--surface); min-width: 900px; }
  thead th {
    background: linear-gradient(135deg, var(--accent), #8b5cf6);
    color: #fff;
    padding: 0.875rem 1rem;
    text-align: left;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  tbody td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.85rem;
    vertical-align: top;
    line-height: 1.5;
  }
  tbody tr:hover td { background: var(--surface2); transition: background 0.15s; }
  tbody tr:last-child td { border-bottom: none; }

  .rank { color: var(--muted); font-size: 0.8rem; font-weight: 600; }
  .name-cell .name { font-weight: 600; color: var(--text); }
  .name-cell .location { font-size: 0.75rem; color: var(--muted); margin-top: 2px; }
  .name-cell a { color: var(--accent-light); text-decoration: none; }
  .name-cell a:hover { text-decoration: underline; }
  .company-cell .company { font-weight: 500; }
  .company-cell .title { font-size: 0.78rem; color: var(--muted); }

  .score-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.85rem;
  }
  .score-excellent { background: rgba(16,185,129,.15); color: #34d399; border: 1px solid rgba(16,185,129,.3); }
  .score-good      { background: rgba(99,102,241,.15);  color: #818cf8; border: 1px solid rgba(99,102,241,.3); }
  .score-fair      { background: rgba(245,158,11,.15);  color: #fbbf24; border: 1px solid rgba(245,158,11,.3); }
  .score-low       { background: rgba(239,68,68,.15);   color: #f87171; border: 1px solid rgba(239,68,68,.3); }

  .skills { display: flex; flex-wrap: wrap; gap: 4px; max-width: 200px; }
  .skill-tag {
    background: rgba(99,102,241,.12);
    color: var(--accent-light);
    border-radius: 4px;
    padding: 2px 7px;
    font-size: 0.7rem;
    font-weight: 500;
  }
  .note { font-style: italic; color: var(--muted); max-width: 280px; font-size: 0.8rem; line-height: 1.4; }

  .status-badge {
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: capitalize;
  }
  .status-approved { background: rgba(16,185,129,.15); color: #34d399; }
  .status-analyzed { background: rgba(99,102,241,.15); color: #818cf8; }
  .status-skipped  { background: rgba(239,68,68,.1);   color: #f87171; }
  .status-new      { background: rgba(148,163,184,.1);  color: #94a3b8; }

  footer { margin-top: 2rem; text-align: center; color: var(--muted); font-size: 0.75rem; }
</style>
</head>
<body>
<header>
  <div class="logo">
    <h1>🤝 liai</h1>
    <span>LinkedIn AI Networking Report</span>
  </div>
  <div class="meta">
    Generated: {{ generated_at }}<br>
    Total profiles: <strong>{{ total }}</strong>
  </div>
</header>

<div class="stats-grid">
  <div class="stat-card">
    <div class="number">{{ total }}</div>
    <div class="label">Total Profiles</div>
  </div>
  {% set approved = rows | selectattr('status', 'equalto', 'approved') | list | length %}
  {% set avg_score = (rows | map(attribute='networking_score') | sum) / (rows | length) if rows else 0 %}
  <div class="stat-card">
    <div class="number" style="color:#34d399">{{ approved }}</div>
    <div class="label">Approved</div>
  </div>
  <div class="stat-card">
    <div class="number" style="color:#818cf8">{{ "%.1f"|format(avg_score) }}</div>
    <div class="label">Avg Score</div>
  </div>
  {% set top_score = rows | map(attribute='networking_score') | max if rows else 0 %}
  <div class="stat-card">
    <div class="number" style="color:#fbbf24">{{ "%.1f"|format(top_score) }}</div>
    <div class="label">Top Score</div>
  </div>
</div>

<div class="table-container">
<table>
  <thead>
    <tr>
      <th>#</th>
      <th>Name</th>
      <th>Company / Title</th>
      <th>Skills</th>
      <th>Score</th>
      <th>Connection Note</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
  {% for row in rows %}
  {% set sc = row.networking_score %}
  {% if sc >= 8 %}{% set sc_cls = 'excellent' %}
  {% elif sc >= 6 %}{% set sc_cls = 'good' %}
  {% elif sc >= 4 %}{% set sc_cls = 'fair' %}
  {% else %}{% set sc_cls = 'low' %}{% endif %}
  <tr>
    <td class="rank">{{ loop.index }}</td>
    <td class="name-cell">
      <div class="name"><a href="{{ row.url }}" target="_blank">{{ row.name or '—' }}</a></div>
      <div class="location">{{ row.location }}</div>
      {% if row.headline %}<div style="font-size:0.75rem;color:#64748b;margin-top:2px">{{ row.headline[:60] }}</div>{% endif %}
    </td>
    <td class="company-cell">
      <div class="company">{{ row.company or '—' }}</div>
      <div class="title">{{ row.title }}</div>
    </td>
    <td>
      <div class="skills">
        {% for skill in row.skills.split(', ')[:5] if skill %}
          <span class="skill-tag">{{ skill }}</span>
        {% endfor %}
      </div>
    </td>
    <td>
      <div class="score-badge score-{{ sc_cls }}">
        {{ "%.1f"|format(sc) }}
      </div>
      <div style="font-size:0.7rem;color:var(--muted);margin-top:4px">{{ row.score_label }}</div>
    </td>
    <td class="note">{{ row.connection_note or '—' }}</td>
    <td><span class="status-badge status-{{ row.status }}">{{ row.status }}</span></td>
  </tr>
  {% endfor %}
  </tbody>
</table>
</div>

<footer>
  Generated by <strong>liai</strong> — LinkedIn AI Networking Assistant &nbsp;|&nbsp;
  Connection requests must be sent manually on LinkedIn.
</footer>
</body>
</html>
