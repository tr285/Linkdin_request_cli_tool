# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.7

# ── Application ─────────────────────────────────────────────────────────────────
LIAI_THEME=dark                   # dark | light
LIAI_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LIAI_HEADLESS=false               # true = no browser window
LIAI_RATE_LIMIT_DELAY=3.0        # seconds between LinkedIn requests

# ── Paths (optional overrides) ──────────────────────────────────────────────────
LIAI_DATABASE_PATH=database/liai.db
LIAI_CACHE_DIR=cache
LIAI_EXPORT_DIR=reports
LIAI_LOG_DIR=logs
LIAI_COOKIES_PATH=.liai_session.json
